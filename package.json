	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && vp check && svelte-check --tsconfig ./tsconfig.json",
		"check:fix": "vp check --fix",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vp test",
		"test": "vp test --run",
		"lint": "vp lint .",
		"lint:fix": "vp lint . --fix",
		"format": "vp fmt .",
		"format:check": "vp fmt . --check",
		"test:coverage": "vp test --coverage",
		"check:all": "bun run check && vp test --run"
	},
	"dependencies": {
		"@iconify/svelte": "^5.2.2",
