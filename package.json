		"@types/culori": "^4.0.1",
		"@vitest/browser-playwright": "5.0.4",
		"@vitest/coverage-v8": "5.0.4",
		"clsx": "^2.1.1",
		"daisyui": "^5.7.16",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "^27.4.0",
